# HuggingFace token (necesario para pyannote diarizacion)
# Obtener en: https://huggingface.co/settings/tokens
# Aceptar licencia en: https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxx

# LM Studio / Ollama (servidor local)
# Ollama:    http://localhost:11434/v1  (modelo: llama3.1:8b)
# LM Studio: http://localhost:1234/v1   (modelo: llama-3.1-8b-instruct)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1:8b
# LLM_API_KEY=not-needed  # Solo necesario si tu servidor local requiere key
# LLM_FALLBACK_MODELS=    # Modelos fallback locales separados por comas

# Groq Cloud (fallback automatico si el servidor local no responde)
# Obtener API key en: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxx

# SQL Server
SQL_SERVER=localhost
SQL_DATABASE=CallCenter
SQL_USERNAME=sa
SQL_PASSWORD=tu_password
SQL_DRIVER=ODBC Driver 17 for SQL Server

# Whisper
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_LANGUAGE=es
